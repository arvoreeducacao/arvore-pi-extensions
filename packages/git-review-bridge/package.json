{
  "name": "@arvoretech/pi-git-review-bridge",
  "version": "0.1.0",
  "description": "Local pi bridge for git-review-cloud: connects to the cloud hub over WebSocket and injects browser review comments into the running pi session",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "git",
    "code-review",
    "cloud"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/arvore-pi-extensions.git",
    "directory": "packages/git-review-bridge"
  },
  "author": "Arvore",
  "license": "MIT"
}
