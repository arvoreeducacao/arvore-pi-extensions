{
  "name": "@arvoretech/pi-catch-the-fox",
  "version": "0.8.0",
  "description": "PI extension: raposa, capivara ou raposa guerreira em pixel-art que reage ao que o agente está fazendo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "preview": "pnpm build && node preview.mjs",
    "preview:compare": "pnpm build && node preview.mjs --compare",
    "preview:frames": "pnpm build && node preview.mjs --frames /tmp/catch-the-fox-frames.png",
    "preview:sheet": "pnpm build && node preview.mjs --sheet /tmp/catch-the-fox-preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "^20.10.0",
    "sharp": "0.34.5",
    "typescript": "^5.3.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "fox",
    "capybara",
    "warrior",
    "widget",
    "pixel-art",
    "fun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/arvore-pi-extensions.git",
    "directory": "packages/catch-the-fox"
  },
  "author": "Arvore",
  "license": "MIT"
}
