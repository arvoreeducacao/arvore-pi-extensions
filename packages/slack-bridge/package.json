{
  "name": "@arvoretech/pi-slack-bridge",
  "version": "1.5.0",
  "description": "PI extension that bridges the active Pi session to a Slack thread: mirrors messages both ways, one Slack thread per Pi session",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "dependencies": {
    "@slack/socket-mode": "2.0.7",
    "@slack/web-api": "7.17.0",
    "slackify-markdown": "5.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-ai": "latest",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "slack",
    "bridge",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/arvore-pi-extensions.git",
    "directory": "packages/slack-bridge"
  },
  "author": "Arvore",
  "license": "MIT"
}
